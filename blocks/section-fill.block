<!-- Section Fill: reusable full-viewport (minus fixed header) scroll-snap section. -->
<!-- The reusable "class": applied per Sections-collection item via {@|apply section-fill.block}. -->
<!-- Scope = the current item, so {title}/{body}/{@|image-meta} resolve against it. -->
<!-- NOTE: <squarespace:block-field> is illegal inside a .block (region/page only); editable -->
<!-- image/text comes from the collection item, not an embedded block-field. -->
<!-- Styles in styles/site.less (.section-fill + html scroll-snap root). -->
<section class="section-fill" data-section-fill>
  {.main-image?}<img class="section-fill__image" {@|image-meta} />{.end}
  <div class="section-fill__content">
    <h2 class="section-fill__title">{title}</h2>
    {body}
  </div>
</section>

<!-- Showcase card: one Showcase-collection item rendered as a window-layout pane. -->
<!-- Applied per item from the <squarespace:query> loop in collections/sections.list (sectionType=="showcase"). -->
<!-- squarespace: tags must live in the .list, NOT in a .block - this file is pure markup applied at the -->
<!-- query item's scope. Mirrors window.block: image + cols; only subtitle (item title) and the "More -->
<!-- Details" link (customContent.linkUrl) panes are populated. The glass mask is NOT here - it lives once -->
<!-- at the section level (sections.list) so it stays fixed while cards slide behind it. The card must keep -->
<!-- z-index:auto (no transform) so the section glass can layer between the image and the cols. -->
<!-- Styles inherited from .section-fill--window + .section-fill--showcase (site.less). JS hook: data-showcase-card. -->
<!-- IMPORTANT: never put JSON-T tags in comments - they evaluate. -->
<div class="section-fill__card" data-showcase-card>
  {.main-image?}<img class="section-fill__image" {@|image-meta} alt="{title}" />{.end}
  <div class="section-fill__cols">
    <div class="section-fill__col section-fill__col--left"></div>
    <div class="section-fill__col section-fill__col--right">
      {.equal? title ""}{.or}<p class="section-fill__subtitle">{title}</p>{.end}
      {.section customContent}{.equal? linkUrl ""}{.or}<a class="section-fill__link" href="{linkUrl}">More Details</a>{.end}{.end}
    </div>
  </div>
</div>

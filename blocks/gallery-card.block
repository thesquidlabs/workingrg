<!-- Gallery card: one Showcase-Gallery-collection item rendered as a boxed white card. -->
<!-- Applied per item from the <squarespace:query> loop in collections/sections.list (sectionType=="gallery") -->
<!-- and from collections/showcasegallery.list. Pure markup applied at the query item's scope -->
<!-- (base image/text item: image + title + body). squarespace: tags must NOT live in a .block. -->
<!-- Three content states, each its own modifier (styles in site.less .section-fill--gallery): -->
<!--   --full  = image + text (title and/or body)   --image = image only   --text = title/body, no image -->
<!-- CRITICAL: each predicate branch emits its OWN complete, balanced <div>...</div>. Do NOT open the -->
<!-- outer <div> in one branch and close it after the {.end} - the JSONT compiler drops a tag split -->
<!-- across predicates and the applied block renders NOTHING (empty track). This bit us once. -->
<!-- title?: {.field?} is truthy on "" - skip a blank title via {.equal? title ""}; body uses {.if body}. -->
<!-- JS hook: data-gallery-card (carousel measures its width). Never put JSON-T tags in comments - they evaluate. -->
{.main-image?}
  {.equal? title ""}
    {.if body}
      <div class="gallery-card gallery-card--full" data-gallery-card><img class="gallery-card__image" {@|image-meta} alt="{title}" /><div class="gallery-card__body">{body}</div></div>
    {.or}
      <div class="gallery-card gallery-card--image" data-gallery-card><img class="gallery-card__image" {@|image-meta} alt="{title}" /></div>
    {.end}
  {.or}
    <div class="gallery-card gallery-card--full" data-gallery-card><img class="gallery-card__image" {@|image-meta} alt="{title}" /><h3 class="gallery-card__title">{title}</h3>{.if body}<div class="gallery-card__body">{body}</div>{.end}</div>
  {.end}
{.or}
  <div class="gallery-card gallery-card--text" data-gallery-card>{.equal? title ""}{.or}<h3 class="gallery-card__title">{title}</h3>{.end}{.if body}<div class="gallery-card__body">{body}</div>{.end}</div>
{.end}

<!-- Sections collection list view. Each item = one full-viewport scroll-snap section. -->
<!-- IMPORTANT: never write JSON-T tags (braces) in comments here - they still evaluate and -->
<!-- break parsing. Dispatch on the CMS "Section Type" field per item: each structural variant -->
<!-- maps to its own block. The equal-predicate literal must be QUOTED; an unquoted arg is -->
<!-- dereferenced as a key. Read sectionType as a bare key inside the customContent section -->
<!-- (current scope); a dotted path would resolve from top-level. The item is captured first so -->
<!-- each applied block keeps item scope (applying at customContent scope loses title/body/image). -->
{.repeated section items}
  {.var @item @}
  {.var @secTitle title}
  {.var @secImage assetUrl}
  {.section customContent}
    {.equal? sectionType "gallery"}
      <!-- Horizontal gallery: title bar + full-bleed section image + 3-up card strip with chevrons + dots. -->
      <!-- Cards come from the collection whose slug the editor typed into galleryCollection (interpolated -->
      <!-- into the query - no per-gallery code). Background + bar text are the SECTION item's own image/title, -->
      <!-- read via @item because the query below re-scopes to the queried card collection. JS: data-gallery. -->
      {.var @gallerySlug galleryCollection}
      <section class="section-fill section-fill--gallery" data-section-fill data-gallery>
        {.equal? @secImage ""}{.or}<img class="section-fill__image" src="{@secImage}?format=1500w" alt="{@secTitle}" />{.end}
        <div class="section-fill__bar">{@secTitle}</div>
        <div class="gallery__stage">
          <button class="gallery__chevron gallery__chevron--prev" data-gallery-prev aria-label="Previous" disabled></button>
          <div class="gallery__viewport">
            <div class="gallery__track" data-gallery-track>
              {.equal? galleryCollection ""}{.or}
                <squarespace:query collection="{@gallerySlug}">
                  {.repeated section items}
                    {@|apply gallery-card.block}
                  {.end}
                </squarespace:query>
              {.end}
            </div>
          </div>
          <button class="gallery__chevron gallery__chevron--next" data-gallery-next aria-label="Next"></button>
        </div>
        <div class="gallery__dots" data-gallery-dots>
          {.equal? galleryCollection ""}{.or}
            <squarespace:query collection="{@gallerySlug}">
              {.repeated section items}
                <span class="gallery__dot" data-gallery-dot></span>
              {.end}
            </squarespace:query>
          {.end}
        </div>
      </section>
    {.or}{.equal? sectionType "showcase"}
      <div class="showcase" data-showcase>
        <squarespace:query collection="showcase">
          <div class="showcase__stage section-fill section-fill--window section-fill--showcase" data-section-fill data-showcase-stage>
            {.repeated section items}
              {@|apply showcase-card.block}
            {.end}
            <div class="section-fill__dots">
              {.repeated section items}
                <span class="section-fill__dot" data-showcase-dot></span>
              {.end}
            </div>
            <div class="glass"></div>
          </div>
          <div class="showcase__rail" aria-hidden="true">
            {.repeated section items}
              <div class="showcase__stop" data-showcase-stop></div>
            {.end}
          </div>
        </squarespace:query>
      </div>
    {.or}{.equal? sectionType "window"}
      {@item|apply window.block}
    {.or}
      {@item|apply section-fill.block}
    {.end}{.end}{.end}
  {.or}
    {@item|apply section-fill.block}
  {.end}
{.or}
  No sections yet.
{.end}

<!-- Sections collection list view. Each item = one full-viewport scroll-snap section. -->
<!-- Structure lives once in blocks/section-fill.block; applied per item (the "class"). -->
{.repeated section items}
  {.var @secType customContent.sectionType}
  {.equal? @secType window}
    {@|apply window.block}
  {.or}
    {@|apply section-fill.block}
  {.end}
{.or}
  No sections yet.
{.end}
